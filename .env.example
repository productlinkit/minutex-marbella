# Base URL of the MinuteX app (register / login)
VITE_APP_URL=https://apps.minutex.linkit360.ai
# Optional: backend endpoint that validates & reserves an exclusive invite.
# When empty, the form redirects straight to the app's register page with the invite params.
VITE_REDEEM_API_URL=
# Override the early-access download links on /welcome (defaults live in src/config/offer.js)
VITE_IOS_TESTFLIGHT_URL=
VITE_ANDROID_APK_URL=
# "Contact support" link on /welcome (defaults to mailto:support@linkit360.ai)
VITE_SUPPORT_URL=
